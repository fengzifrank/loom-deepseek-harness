{
  "name": "dsh-web-approval-answerer",
  "version": "0.1.0",
  "description": "SSE approval answerer for DeepSeek Harness: approval/request -> host-pushed SSE approval card, pending registry with reconnect replay, idempotent settle (concurrent 409), timeout fail-closed",
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "approval",
    "sse"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@types/node": "24.13.3",
    "typescript": "5.9.3"
  }
}
