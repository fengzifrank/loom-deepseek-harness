{
  "name": "@loom-sdk/web",
  "version": "0.1.0",
  "description": "Loom — declarative agent web framework on DeepSeek Harness",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./react": {
      "types": "./lib/react.d.ts",
      "default": "./lib/react.js"
    },
    "./react-ui": {
      "types": "./lib/react-ui/index.d.ts",
      "default": "./lib/react-ui/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "loom": "./bin/loom.js"
  },
  "files": [
    "bin",
    "lib"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@deepseek-ai/dsh-app-boot": "0.1.2-rc.1",
    "@deepseek-ai/dsh-llm": "0.1.2-rc.1",
    "@deepseek-ai/dsh-tools": "0.1.2-rc.1",
    "@deepseek-ai/schemastery": "3.18.2",
    "dsh-python-tools": "workspace:*",
    "dsh-web-approval-answerer": "workspace:*",
    "tsx": "4.23.12",
    "@deepseek-ai/cordis-plugin-timer": "1.1.4",
    "@deepseek-ai/dsh-brand": "0.1.2-rc.1",
    "@deepseek-ai/dsh-util-values": "0.1.2-rc.1",
    "@deepseek-ai/dsh-typert-protocol": "0.1.2-rc.1",
